+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import { Star, CheckCircle2, Send } from "lucide-react";
+import { gsap } from "@/lib/gsap";
+import { siteConfig } from "@/lib/site-config";
+import { HONEYPOT_FIELD } from "@/lib/forms";
+import { TextField, TextAreaField, Honeypot } from "@/components/FormField";
+
+const EMPTY = { fullName: "", email: "", companyName: "", companyWebsite: "", quote: "" };
+const QUOTE_MAX = 1000;
+
+/** Accessible 1-5 picker: a radio group with arrow-key support and a hover preview. */
+function StarPicker({ value, onChange, invalid }) {
+  const [hover, setHover] = useState(0);
+  const shown = hover || value;
+
+  const onKey = (e) => {
+    if (e.key === "ArrowRight" || e.key === "ArrowUp") {
+      e.preventDefault();
+      onChange(Math.min(5, (value || 0) + 1));
+    } else if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
+      e.preventDefault();
+      onChange(Math.max(1, (value || 2) - 1));
+    }
+  };
+
+  return (
+    <div role="radiogroup" aria-label="Star rating" aria-required="true" onMouseLeave={() => setHover(0)}
+      className={`-ml-1 flex gap-0.5 ${invalid ? "outline outline-1 outline-offset-4 outline-maroon" : ""}`}>
+      {[1, 2, 3, 4, 5].map((n) => (
+        <button
+          key={n}
+          type="button"
+          role="radio"
+          aria-checked={value === n}
+          aria-label={`${n} star${n > 1 ? "s" : ""}`}
+          tabIndex={value === n || (!value && n === 1) ? 0 : -1}
+          onClick={() => onChange(n)}
+          onKeyDown={onKey}
+          onMouseEnter={() => setHover(n)}
+          className="p-1 transition-transform duration-150 hover:scale-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-maroon"
+        >
+          <Star size={30} strokeWidth={1.5} className={n <= shown ? "fill-maroon text-maroon" : "text-ink/30"} />
+        </button>
+      ))}
+    </div>
+  );
+}
+
+export default function TestimonialForm() {
+  const [values, setValues] = useState(EMPTY);
+  const [rating, setRating] = useState(0);
+  const [trap, setTrap] = useState("");
+  const [status, setStatus] = useState("idle"); // idle | sending | sent | error
+  const [error, setError] = useState("");
+  const doneRef = useRef(null);
+
+  const set = (key) => (e) => setValues((v) => ({ ...v, [key]: e.target.value }));
+
+  useEffect(() => {
+    if (status !== "sent" || !doneRef.current) return;
+    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
+      gsap.fromTo(doneRef.current, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" });
+    }
+    doneRef.current.focus();
+  }, [status]);
+
+  async function onSubmit(e) {
+    e.preventDefault();
+    if (status === "sending") return;
+    if (!rating) {
+      setError("Please choose a star rating.");
+      setStatus("error");
+      return;
+    }
+    setStatus("sending");
+    setError("");
+    try {
+      const res = await fetch("/api/testimonials", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ ...values, rating, [HONEYPOT_FIELD]: trap }),
+      });
+      const data = await res.json().catch(() => ({}));
+      if (!res.ok) throw new Error(data.error || "Something went wrong. Please try again.");
+      setValues(EMPTY);
+      setRating(0);
+      setStatus("sent");
+    } catch (err) {
+      // The old form showed "submitted" even when this failed. Now it only
+      // says so when the server confirmed it.
+      setError(
+        err instanceof TypeError
+          ? "We couldn't reach the server. Please check your connection and try again."
+          : err.message
+      );
+      setStatus("error");
+    }
+  }
+
+  if (status === "sent") {
+    return (
+      <div ref={doneRef} tabIndex={-1} role="status" className="py-6 outline-none">
+        <CheckCircle2 size={34} strokeWidth={1.5} className="text-maroon" />
+        <h3 className="mt-5 font-display text-3xl sm:text-4xl">Thank you for your testimonial.</h3>
+        <p className="mt-3 max-w-md text-sm leading-relaxed text-ink/75">
+          We&rsquo;ve received it. It will be read by the chambers and published once approved. Your email address is never shown.
+        </p>
+        <button type="button" onClick={() => setStatus("idle")} className="mt-6 text-sm text-ink/60 underline underline-offset-4 hover:text-maroon">
+          Submit another
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <form onSubmit={onSubmit} className="relative space-y-3" aria-busy={status === "sending"}>
+      <div className="grid gap-x-8 gap-y-3 sm:grid-cols-2">
+        <TextField id="fullName" label="Full name" required autoComplete="name" maxLength={100} value={values.fullName} onChange={set("fullName")} />
+        <TextField id="email" label="Email (never shown)" type="email" required autoComplete="email" maxLength={254} value={values.email} onChange={set("email")} />
+        <TextField id="companyName" label="Company (optional)" autoComplete="organization" maxLength={100} value={values.companyName} onChange={set("companyName")} />
+        <TextField id="companyWebsite" label="Website (optional)" inputMode="url" maxLength={200} value={values.companyWebsite} onChange={set("companyWebsite")} />
+      </div>
+
+      <div>
+        <TextAreaField id="quote" label="Your testimonial" required rows={5} maxLength={QUOTE_MAX} value={values.quote} onChange={set("quote")} />
+        <p className="mt-1 text-right text-xs text-ink/45" aria-live="off">
+          {values.quote.length}/{QUOTE_MAX}
+        </p>
+      </div>
+
+      <div className="pt-2">
+        <p className="mb-1 text-sm text-ink/70">
+          Your rating <span aria-hidden="true">*</span>
+        </p>
+        <StarPicker value={rating} onChange={setRating} invalid={status === "error" && !rating} />
+      </div>
+
+      <Honeypot name={HONEYPOT_FIELD} value={trap} onChange={(e) => setTrap(e.target.value)} />
+
+      {status === "error" && (
+        <p role="alert" className="border border-maroon/30 bg-maroon/5 px-4 py-3 text-sm text-ink">
+          {error}
+          {rating > 0 && (
+            <>
+              {" "}You can also contact us on{" "}
+              <a href={siteConfig.phone.href} className="underline underline-offset-4">
+                {siteConfig.phone.value}
+              </a>
+              .
+            </>
+          )}
+        </p>
+      )}
+
+      <div className="space-y-4 pt-3">
+        <button
+          type="submit"
+          disabled={status === "sending"}
+          className="inline-flex h-12 items-center gap-2 bg-ink px-7 font-sans text-sm font-medium tracking-wide text-parchment transition-colors hover:bg-maroon disabled:cursor-wait disabled:opacity-60"
+        >
+          {status === "sending" ? "Sending…" : "Submit testimonial"}
+          <Send size={15} />
+        </button>
+        <p className="max-w-lg text-xs leading-relaxed text-ink/50">
+          Please don&rsquo;t include details of your case. By submitting, you agree that your name, company and
+          testimonial may be published on this website after review.
+        </p>
+      </div>
+    </form>
+  );
+}
diff -ruN a/src/lib/form-handlers.js b/src/lib/form-handlers.js
--- a/src/lib/form-handlers.js	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/form-handlers.js	2026-10-30 08:41:52.736535136 +0000
@@ -0,0 +1,48 @@
+import { validateContact, validateTestimonial, checkRateLimit } from "@/lib/forms";
+
+/**
+ * The decision logic behind /api/contact and /api/testimonials, kept free of
+ * Next so it can be tested directly. The route files are thin adapters.
+ *
+ * Each function returns { status, body, headers? } and NEVER throws.
+ * Order matters: rate-limit first (every attempt counts, including invalid
+ * and bot ones), then validate, then drop bots silently, then save.
+ */
+
+const TOO_MANY = "Too many attempts. Please wait a few minutes and try again.";
+const SAVE_FAILED =
+  "We couldn't send this just now. Please try again shortly, or contact us by phone.";
+
+async function run({ kind, body, ip, validate, save, limit, rate, log }) {
+  // Without a usable IP everyone shares one bucket, so give it more room
+  // rather than risk locking real clients out.
+  const unknownIp = ip === "unknown";
+  const rl = checkRateLimit(`${kind}:${ip}`, { limit: unknownIp ? limit * 6 : limit, ...rate });
+  if (!rl.ok) {
+    return { status: 429, body: { error: TOO_MANY }, headers: { "Retry-After": String(rl.retryAfter) } };
+  }
+
+  const v = validate(body);
+  if (v.honeypot) {
+    // Look like success so the bot moves on; store nothing.
+    return { status: 200, body: { ok: true } };
+  }
+  if (!v.ok) return { status: 400, body: { error: v.error, fields: v.fields } };
+
+  try {
+    await save(v.data);
+  } catch (err) {
+    // Detail goes to the server log only; visitors get a plain message.
+    log(`[${kind}] could not save to Strapi: ${err?.message ?? err}`);
+    return { status: 502, body: { error: SAVE_FAILED } };
+  }
+  return { status: 200, body: { ok: true } };
+}
+
+export function processContact({ body, ip, create, rate, log = console.error }) {
+  return run({ kind: "contact", body, ip, validate: validateContact, save: create, limit: 5, rate, log });
+}
+
+export function processTestimonial({ body, ip, create, rate, log = console.error }) {
+  return run({ kind: "testimonial", body, ip, validate: validateTestimonial, save: create, limit: 3, rate, log });
+}
diff -ruN a/src/lib/forms.js b/src/lib/forms.js
--- a/src/lib/forms.js	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/forms.js	2026-10-30 08:41:52.730973624 +0000
@@ -0,0 +1,165 @@
+/**
+ * Validation, abuse protection and request reading for the public forms
+ * (contact + testimonial). Pure JavaScript with no imports, so all of it is
+ * unit-tested without Next or Strapi running.
+ *
+ * Why this lives on OUR server and not in the browser: the browser never
+ * talks to Strapi for these forms. Our route handlers validate, filter spam,
+ * and only then create the entry in Strapi with a server-side token. That
+ * means the checks below cannot be bypassed by posting straight to Strapi.
+ */
+
+/** Honeypot: hidden from humans, irresistible to form-filling bots. */
+export const HONEYPOT_FIELD = "contact_extra";
+
+const EMAIL = /^[^\s@,;<>]+@[^\s@,;<>]+\.[^\s@,;<>]+$/;
+// Single-line fields must never contain line breaks (header injection when
+// a field later lands in an email subject / reply-to).
+const LINE_BREAK = /[\r\n\u2028\u2029]/;
+// control characters except \t \n \r
+const CONTROL = /[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/g;
+
+const str = (v) => (typeof v === "string" ? v : "");
+
+function line(v, { min = 0, max, label, required }) {
+  const s = str(v).replace(CONTROL, "").trim();
+  if (!s) return required ? { error: `Please enter ${label}.` } : { value: "" };
+  if (LINE_BREAK.test(s)) return { error: `${cap(label)} must be on a single line.` };
+  if (s.length < min) return { error: `${cap(label)} is too short.` };
+  if (s.length > max) return { error: `${cap(label)} is too long (maximum ${max} characters).` };
+  return { value: s };
+}
+
+function block(v, { min = 0, max, label, required }) {
+  const s = str(v).replace(CONTROL, "").replace(/\r\n?/g, "\n").trim();
+  if (!s) return required ? { error: `Please enter ${label}.` } : { value: "" };
+  if (s.length < min) return { error: `${cap(label)} is too short (at least ${min} characters).` };
+  if (s.length > max) return { error: `${cap(label)} is too long (maximum ${max} characters).` };
+  return { value: s };
+}
+
+const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
+
+function email(v) {
+  const r = line(v, { max: 254, label: "your email address", required: true });
+  if (r.error) return r;
+  return EMAIL.test(r.value) ? r : { error: "Please enter a valid email address." };
+}
+
+/** Optional website: add https:// if missing, accept only real http(s) hosts. */
+function website(v) {
+  const r = line(v, { max: 200, label: "a website address", required: false });
+  if (r.error || !r.value) return r;
+  const candidate = /^[a-z][a-z0-9+.-]*:\/\//i.test(r.value) ? r.value : `https://${r.value}`;
+  let u;
+  try {
+    u = new URL(candidate);
+  } catch {
+    return { error: "Please enter a valid website address, or leave it blank." };
+  }
+  const okProtocol = u.protocol === "http:" || u.protocol === "https:";
+  if (!okProtocol || !u.hostname.includes(".") || u.username || u.password) {
+    return { error: "Please enter a valid website address, or leave it blank." };
+  }
+  return { value: u.toString() };
+}
+
+function collect(parts, honeypotValue) {
+  if (str(honeypotValue).trim() !== "") return { ok: false, honeypot: true };
+  const fields = {};
+  const data = {};
+  for (const [key, r] of Object.entries(parts)) {
+    if (r.error) fields[key] = r.error;
+    else if (r.value !== "" && r.value !== undefined) data[key] = r.value;
+  }
+  const first = Object.values(fields)[0];
+  return first ? { ok: false, error: first, fields } : { ok: true, data };
+}
+
+/** Contact form: name, email, subject required; message optional (as on the original site). */
+export function validateContact(body) {
+  const b = body && typeof body === "object" ? body : {};
+  return collect(
+    {
+      name: line(b.name, { min: 2, max: 100, label: "your name", required: true }),
+      email: email(b.email),
+      subject: line(b.subject, { min: 3, max: 200, label: "a subject", required: true }),
+      message: block(b.message, { max: 5000, label: "your message", required: false }),
+    },
+    b[HONEYPOT_FIELD]
+  );
+}
+
+/** Testimonial form. Limits mirror the Strapi schema (quote max 1000, rating 1-5). */
+export function validateTestimonial(body) {
+  const b = body && typeof body === "object" ? body : {};
+  const n = typeof b.rating === "string" && b.rating.trim() !== "" ? Number(b.rating) : b.rating;
+  const rating =
+    Number.isInteger(n) && n >= 1 && n <= 5
+      ? { value: n }
+      : { error: "Please choose a star rating from 1 to 5." };
+  return collect(
+    {
+      fullName: line(b.fullName, { min: 2, max: 100, label: "your full name", required: true }),
+      email: email(b.email),
+      companyName: line(b.companyName, { max: 100, label: "a company name", required: false }),
+      companyWebsite: website(b.companyWebsite),
+      quote: block(b.quote, { min: 10, max: 1000, label: "your testimonial", required: true }),
+      rating,
+    },
+    b[HONEYPOT_FIELD]
+  );
+}
+
+/* ----------------------------- rate limiting ----------------------------- */
+
+const defaultStore = new Map();
+
+/**
+ * Sliding-window limiter, in memory. Fine for a single Node process (the
+ * VPS runs one); it resets on restart, which is acceptable for spam control.
+ * Pass your own `store`/`now` in tests.
+ */
+export function checkRateLimit(
+  key,
+  { limit = 5, windowMs = 10 * 60 * 1000, now = Date.now(), store = defaultStore } = {}
+) {
+  const recent = (store.get(key) ?? []).filter((t) => now - t < windowMs);
+  if (recent.length >= limit) {
+    store.set(key, recent);
+    return { ok: false, retryAfter: Math.max(1, Math.ceil((recent[0] + windowMs - now) / 1000)) };
+  }
+  recent.push(now);
+  store.set(key, recent);
+  if (store.size > 2000) {
+    for (const [k, times] of store) {
+      if (!times.some((t) => now - t < windowMs)) store.delete(k);
+    }
+  }
+  return { ok: true };
+}
+
+/** Best-effort client IP behind a reverse proxy. "unknown" if no usable header. */
+export function clientIp(headers) {
+  const raw = headers?.get?.("x-forwarded-for")?.split(",")[0]?.trim() || headers?.get?.("x-real-ip")?.trim() || "";
+  return /^[0-9a-fA-F:.]{3,45}$/.test(raw) ? raw : "unknown";
+}
+
+/**
+ * Read a JSON body with a hard size cap (so a huge POST can't be used to
+ * burn memory). `request` only needs a .text() method.
+ */
+export async function readJsonBody(request, maxChars = 20000) {
+  let raw;
+  try {
+    raw = await request.text();
+  } catch {
+    return { ok: false, status: 400, error: "Invalid request." };
+  }
+  if (raw.length > maxChars) return { ok: false, status: 413, error: "That message is too long." };
+  try {
+    return { ok: true, body: JSON.parse(raw) };
+  } catch {
+    return { ok: false, status: 400, error: "Invalid request." };
+  }
+}
diff -ruN a/src/lib/strapi-server.js b/src/lib/strapi-server.js
--- a/src/lib/strapi-server.js	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/strapi-server.js	2026-10-30 08:41:52.742106978 +0000
@@ -0,0 +1,31 @@
+import axios from "axios";
+import { normalizeBaseUrl } from "@/lib/url";
+
+/**
+ * SERVER-ONLY. Creates entries in Strapi using STRAPI_FORMS_TOKEN, which is
+ * deliberately NOT a NEXT_PUBLIC_ variable: it is never sent to a browser.
+ * Only the route handlers under src/app/api import this file.
+ *
+ * The token should be a *Custom* Strapi API token that can only `create`
+ * Contact Message and Testimonial entries — nothing else (see
+ * FORMS-SETUP.md). Even if it leaked, it could not read or change content.
+ */
+export async function createEntry(pluralName, data) {
+  const token = process.env.STRAPI_FORMS_TOKEN;
+  if (!token) throw new Error("STRAPI_FORMS_TOKEN is not set on the server");
+
+  const client = axios.create({
+    baseURL: `${normalizeBaseUrl(process.env.NEXT_PUBLIC_STRAPI_URL)}/api`,
+    headers: { Authorization: `Bearer ${token}` },
+    timeout: 10000,
+  });
+
+  try {
+    const res = await client.post(`/${pluralName}`, { data });
+    return res.data;
+  } catch (err) {
+    const detail = err.response?.data?.error?.message;
+    const status = err.response?.status;
+    throw new Error(`${status ?? err.code ?? "network error"}${detail ? `: ${detail}` : ""}`);
+  }
+}
diff -ruN a/src/lib/url.js b/src/lib/url.js
--- a/src/lib/url.js	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/url.js	2026-10-30 08:41:52.724825697 +0000
@@ -0,0 +1,11 @@
+/**
+ * Base URL of the Strapi server, tolerant of the typo that has already cost
+ * time once: NEXT_PUBLIC_STRAPI_URL set without "http://". A scheme-less
+ * value is not a valid absolute URL for Node's HTTP client.
+ */
+export function normalizeBaseUrl(raw, fallback = "http://localhost:1337") {
+  let u = String(raw ?? "").trim().replace(/\/+$/, "");
+  if (!u) return fallback;
+  if (!/^https?:\/\//i.test(u)) u = `http://${u}`;
+  return u;
+}
