--- a/src/components/FormField.jsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/components/FormField.jsx	2026-10-30 08:41:52.752232394 +0000
@@ -0,0 +1,66 @@
+/**
+ * Floating-label inputs, in pure CSS (Tailwind `peer` + `:placeholder-shown`).
+ * The old contact form animated colours with GSAP using hard-coded hex
+ * values, which ignored the theme switcher; this version reads the theme
+ * tokens (text-ink / text-maroon), so it follows whichever palette is active.
+ *
+ * The input must stay BEFORE the label and underline in the markup: `peer`
+ * only styles later siblings.
+ */
+const labelCls =
+  "pointer-events-none absolute left-0 top-7 origin-left text-sm text-ink/55 transition-all duration-200 " +
+  "peer-focus:-translate-y-6 peer-focus:scale-[0.85] peer-focus:text-maroon " +
+  "peer-[:not(:placeholder-shown)]:-translate-y-6 peer-[:not(:placeholder-shown)]:scale-[0.85]";
+
+const lineCls =
+  "pointer-events-none absolute bottom-0 left-0 h-[2px] w-full origin-left scale-x-0 bg-maroon " +
+  "transition-transform duration-300 peer-focus:scale-x-100";
+
+const inputCls =
+  "peer w-full border-0 border-b border-ink/25 bg-transparent pb-2 pt-1 text-base text-ink outline-none";
+
+export function TextField({ id, name = id, label, required, type = "text", ...rest }) {
+  return (
+    <div className="relative pt-6">
+      <input id={id} name={name} type={type} placeholder=" " required={required} className={inputCls} {...rest} />
+      <label htmlFor={id} className={labelCls}>
+        {label}
+        {required && <span aria-hidden="true"> *</span>}
+      </label>
+      <span className={lineCls} />
+    </div>
+  );
+}
+
+export function TextAreaField({ id, name = id, label, required, rows = 5, ...rest }) {
+  return (
+    <div className="relative pt-6">
+      <textarea
+        id={id}
+        name={name}
+        rows={rows}
+        placeholder=" "
+        required={required}
+        className={`${inputCls} resize-none`}
+        {...rest}
+      />
+      <label htmlFor={id} className={labelCls}>
+        {label}
+        {required && <span aria-hidden="true"> *</span>}
+      </label>
+      <span className={lineCls} />
+    </div>
+  );
+}
+
+/** Off-screen decoy field. Humans never see or reach it; form-filling bots do fill it. */
+export function Honeypot({ name, value, onChange }) {
+  return (
+    <div aria-hidden="true" className="absolute -left-[9999px] h-0 w-0 overflow-hidden">
+      <label>
+        Leave this field empty
+        <input type="text" name={name} tabIndex={-1} autoComplete="off" value={value} onChange={onChange} />
+      </label>
+    </div>
+  );
+}
diff -ruN a/src/components/StarRating.jsx b/src/components/StarRating.jsx
--- a/src/components/StarRating.jsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/components/StarRating.jsx	2026-10-30 08:41:52.759300549 +0000
@@ -0,0 +1,55 @@
+"use client";
+
+import { useEffect, useRef } from "react";
+import { Star } from "lucide-react";
+import { gsap } from "@/lib/gsap";
+
+/**
+ * Read-only star rating. Stars pop in one after another when the card
+ * scrolls into view, and again every time it re-enters (down, back up, down
+ * again) — same repeat-on-every-pass behaviour as the rest of the site.
+ */
+export default function StarRating({ rating, size = 16 }) {
+  const rootRef = useRef(null);
+  const value = Math.max(0, Math.min(5, Math.round(Number(rating) || 0)));
+
+  useEffect(() => {
+    const root = rootRef.current;
+    if (!root || value === 0) return;
+    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
+
+    const ctx = gsap.context(() => {
+      gsap.fromTo(
+        root.querySelectorAll("[data-star]"),
+        { scale: 0.3, opacity: 0 },
+        {
+          scale: 1,
+          opacity: 1,
+          duration: 0.45,
+          stagger: 0.08,
+          ease: "back.out(2.2)",
+          transformOrigin: "50% 50%",
+          scrollTrigger: { trigger: root, start: "top 92%", toggleActions: "play reverse play reverse" },
+        }
+      );
+    }, root);
+    return () => ctx.revert();
+  }, [value]);
+
+  if (value === 0) return null;
+
+  return (
+    <div ref={rootRef} role="img" aria-label={`Rated ${value} out of 5`} className="flex gap-0.5 text-maroon">
+      {[1, 2, 3, 4, 5].map((n) => (
+        <Star
+          key={n}
+          data-star
+          size={size}
+          strokeWidth={1.5}
+          className={n <= value ? "fill-current" : "text-ink/25"}
+          aria-hidden="true"
+        />
+      ))}
+    </div>
+  );
+}
diff -ruN a/src/components/TestimonialCard.jsx b/src/components/TestimonialCard.jsx
--- a/src/components/TestimonialCard.jsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/components/TestimonialCard.jsx	2026-10-30 08:41:52.764232394 +0000
@@ -0,0 +1,43 @@
+import Image from "next/image";
+import StarRating from "@/components/StarRating";
+import { mediaUrl } from "@/lib/strapi";
+
+function initials(name = "") {
+  const parts = name.trim().split(/\s+/).filter(Boolean);
+  if (parts.length === 0) return "?";
+  return (parts[0][0] + (parts.length > 1 ? parts[parts.length - 1][0] : "")).toUpperCase();
+}
+
+/**
+ * One approved testimonial. Shows the Media Library photo if an admin added
+ * one in Strapi, otherwise an initials tile. The submitter's email is never
+ * part of this data (private field), and their website is not linked.
+ */
+export default function TestimonialCard({ item }) {
+  const photo = mediaUrl(item.photo);
+
+  return (
+    <figure className="group border border-ink/10 bg-parchment p-7 transition-colors duration-150 hover:bg-parchment-2 sm:p-8">
+      <StarRating rating={item.rating} />
+      <blockquote className="mt-5 font-display text-2xl leading-snug">
+        &ldquo;{item.quote}&rdquo;
+      </blockquote>
+      <figcaption className="mt-6 flex items-center gap-3">
+        {photo ? (
+          <Image src={photo} alt="" width={44} height={44} className="h-11 w-11 object-cover" />
+        ) : (
+          <span
+            aria-hidden="true"
+            className="flex h-11 w-11 shrink-0 items-center justify-center bg-ink font-display text-lg text-parchment"
+          >
+            {initials(item.fullName)}
+          </span>
+        )}
+        <span className="min-w-0">
+          <span className="block text-sm font-medium">{item.fullName}</span>
+          {item.companyName && <span className="block truncate text-xs text-ink/55">{item.companyName}</span>}
+        </span>
+      </figcaption>
+    </figure>
+  );
+}
